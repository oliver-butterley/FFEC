import Mathlib.Tactic.LinearCombination

/-! # The places at the affine points of a Weierstrass curve

At a nonsingular affine point `(x₀, y₀)` of a Weierstrass curve `W`, the maximal ideal
`⟨x - x₀, y - y₀⟩` of the coordinate ring becomes principal in the local ring
(`exists_maximalIdeal_localRing_eq_span`): it is generated by `x - x₀` when
`∂W/∂Y (x₀, y₀) ≠ 0`, and by `y - y₀` otherwise. The local ring is therefore a discrete valuation
ring, hence a valuation subring of the function field: the place of the point.

## Provenance

The principal generator follows `LocalRingUniformizer.lean` of lana-agents/elliptic-curves
(Apache-2.0): the identity `(y - y₀)(y + y₀ + a₁ x + a₃) = (x - x₀) g(x)` from the equation. -/

public section

universe u

open Polynomial IsLocalRing
open scoped Polynomial.Bivariate

namespace WeierstrassCurve.Affine

variable {F : Type u} [Field F] {W : WeierstrassCurve.Affine F} {x y : F}

open CoordinateRing

/-- The ideal `⟨x - x₀, y - y₀⟩` of a point on the curve is maximal. -/
theorem isMaximal_XYIdeal (h : W.Equation x y) : (XYIdeal W x (C y)).IsMaximal :=
  Ideal.Quotient.maximal_of_isField _
    ((quotientXYIdealEquiv (W' := W) (x := x) (y := C y) h).toMulEquiv.isField (Field.toIsField F))

/-- The key identity `(y - y₀)(y + y₀ + a₁ x + a₃) = (x - x₀) g(x)`. -/
theorem YClass_mul_eq (h : W.Equation x y) :
    YClass W (C y) * CoordinateRing.mk W (Y + C (C y + C W.a₁ * X + C W.a₃)) =
      XClass W x * CoordinateRing.mk W (C (X ^ 2 + C x * X + C (x ^ 2) + C W.a₂ * X +
        C (W.a₂ * x) + C W.a₄ - C (W.a₁ * y))) := by
  rw [YClass, XClass, ← map_mul, ← map_mul]
  refine AdjoinRoot.mk_eq_mk.mpr ⟨1, ?_⟩
  have h' := (equation_iff' x y).mp h
  have hc := congrArg (fun t : F => (C (C t) : F[X][Y])) h'
  simp only [map_sub, map_add, map_mul, map_pow, map_zero] at hc
  rw [Affine.polynomial]
  simp only [map_sub, map_add, map_mul, map_pow]
  linear_combination (-1 : F[X][Y]) * hc

/-- `y + y₀ + a₁ x + a₃ ≡ 2 y₀ + a₁ x₀ + a₃` modulo the ideal of the point. -/
theorem mk_Y_add_eq :
    CoordinateRing.mk W (Y + C (C y + C W.a₁ * X + C W.a₃)) =
      YClass W (C y) + CoordinateRing.mk W (C (C W.a₁)) * XClass W x +
        CoordinateRing.mk W (C (C (2 * y + W.a₁ * x + W.a₃))) := by
  rw [YClass, XClass, ← map_mul, ← map_add, ← map_add]
  congr 1
  simp only [map_add, map_mul, map_ofNat, map_sub]
  ring

/-- `g(x) ≡ 3 x₀² + 2 a₂ x₀ + a₄ - a₁ y₀` modulo the ideal of the point. -/
theorem mk_g_eq :
    CoordinateRing.mk W (C (X ^ 2 + C x * X + C (x ^ 2) + C W.a₂ * X + C (W.a₂ * x) + C W.a₄ -
      C (W.a₁ * y))) =
      XClass W x * CoordinateRing.mk W (C (X + C (2 * x + W.a₂))) +
        CoordinateRing.mk W (C (C (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y))) := by
  rw [XClass, ← map_mul, ← map_add]
  congr 1
  simp only [map_add, map_mul, map_ofNat, map_sub, map_pow]
  ring

/-- A nonzero constant is not in the ideal of a point. -/
theorem mk_C_C_not_mem (h : W.Equation x y) {c : F} (hc : c ≠ 0) :
    CoordinateRing.mk W (C (C c)) ∉ XYIdeal W x (C y) := fun hm =>
  (isMaximal_XYIdeal h).ne_top (Ideal.eq_top_of_isUnit_mem _ hm
    ((Units.mk0 c hc).isUnit.map (algebraMap F W.CoordinateRing)))

/-- An element congruent to a nonzero constant is not in the ideal of a point. -/
theorem add_mk_C_C_not_mem (h : W.Equation x y) {a : W.CoordinateRing}
    (ha : a ∈ XYIdeal W x (C y)) {c : F} (hc : c ≠ 0) :
    a + CoordinateRing.mk W (C (C c)) ∉ XYIdeal W x (C y) :=
  fun hm => mk_C_C_not_mem h hc (by simpa using sub_mem hm ha)

/-- `x - x₀` is in the ideal of the point. -/
theorem XClass_mem_XYIdeal : XClass W x ∈ XYIdeal W x (C y) :=
  Ideal.subset_span (Set.mem_insert _ _)

/-- `y - y₀` is in the ideal of the point. -/
theorem YClass_mem_XYIdeal : YClass W (C y) ∈ XYIdeal W x (C y) :=
  Ideal.subset_span (Set.mem_insert_of_mem _ rfl)

/-! ### The local ring at a point -/

section LocalRing

variable (h : W.Nonsingular x y)

/-- The local ring at a nonsingular point, as a subalgebra of the function field. -/
noncomputable def localRing : Subalgebra W.CoordinateRing W.FunctionField :=
  haveI := (isMaximal_XYIdeal h.1).isPrime
  Localization.subalgebra.ofField W.FunctionField (XYIdeal W x (C y)).primeCompl
    (Ideal.primeCompl_le_nonZeroDivisors _)

/-- The local ring is the localization at the ideal of the point. -/
theorem isLocalization_localRing :
    haveI := (isMaximal_XYIdeal h.1).isPrime
    IsLocalization.AtPrime (localRing h) (XYIdeal W x (C y)) := by
  have := (isMaximal_XYIdeal h.1).isPrime
  exact Localization.subalgebra.isLocalization_ofField _ _ _

/-- **The uniformizer**: the maximal ideal of the local ring at a nonsingular point is principal,
generated by `x - x₀` or by `y - y₀`. -/
theorem exists_maximalIdeal_localRing_eq_span :
    haveI := (isMaximal_XYIdeal h.1).isPrime
    haveI := isLocalization_localRing h
    haveI := IsLocalization.AtPrime.isLocalRing (localRing h) (XYIdeal W x (C y))
    ∃ π ∈ ({XClass W x, YClass W (C y)} : Set W.CoordinateRing),
      maximalIdeal (localRing h) = Ideal.span {algebraMap W.CoordinateRing (localRing h) π} := by
  have := (isMaximal_XYIdeal h.1).isPrime
  have := isLocalization_localRing h
  have := IsLocalization.AtPrime.isLocalRing (localRing h) (XYIdeal W x (C y))
  set φ := algebraMap W.CoordinateRing (localRing h)
  have hmap : (XYIdeal W x (C y)).map φ =
      Ideal.span {φ (XClass W x), φ (YClass W (C y))} := by
    rw [XYIdeal, Ideal.map_span, Set.image_pair]
  set m := XYIdeal W x (C y)
  have hunit : ∀ s ∉ m, IsUnit (φ s) := fun s hs =>
    IsLocalization.map_units (localRing h) (⟨s, hs⟩ : m.primeCompl)
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal m (localRing h), hmap]
  have key := congrArg φ (YClass_mul_eq h.1)
  rw [map_mul, map_mul] at key
  rcases ((nonsingular_iff' x y).mp h).2 with hg | hs
  · -- `∂W/∂X ≠ 0`: `x - x₀ = (y - y₀) s / g`
    refine ⟨YClass W (C y), Set.mem_insert_of_mem _ rfl, le_antisymm ?_ ?_⟩
    · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      refine ⟨?_, Ideal.subset_span rfl⟩
      have hgm : CoordinateRing.mk W (C (X ^ 2 + C x * X + C (x ^ 2) + C W.a₂ * X +
          C (W.a₂ * x) + C W.a₄ - C (W.a₁ * y))) ∉ m := by
        rw [mk_g_eq]
        refine add_mk_C_C_not_mem h.1 (Ideal.mul_mem_right _ _ XClass_mem_XYIdeal) ?_
        intro h0; apply hg; linear_combination -h0
      obtain ⟨u, hu⟩ := hunit _ hgm
      rw [SetLike.mem_coe, Ideal.mem_span_singleton']
      refine ⟨φ (CoordinateRing.mk W (Y + C (C y + C W.a₁ * X + C W.a₃))) * ↑u⁻¹, ?_⟩
      rw [mul_right_comm, mul_comm (φ _), key, ← hu, mul_assoc, Units.mul_inv, mul_one]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  · -- `∂W/∂Y ≠ 0`: `y - y₀ = (x - x₀) g / s`
    refine ⟨XClass W x, Set.mem_insert _ _, le_antisymm ?_ ?_⟩
    · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      refine ⟨Ideal.subset_span rfl, ?_⟩
      have hsm : CoordinateRing.mk W (Y + C (C y + C W.a₁ * X + C W.a₃)) ∉ m := by
        rw [mk_Y_add_eq]
        exact add_mk_C_C_not_mem h.1 (add_mem YClass_mem_XYIdeal
          (Ideal.mul_mem_left _ _ XClass_mem_XYIdeal)) hs
      obtain ⟨u, hu⟩ := hunit _ hsm
      rw [SetLike.mem_coe, Ideal.mem_span_singleton']
      refine ⟨φ (CoordinateRing.mk W (C (X ^ 2 + C x * X + C (x ^ 2) + C W.a₂ * X +
          C (W.a₂ * x) + C W.a₄ - C (W.a₁ * y)))) * ↑u⁻¹, ?_⟩
      rw [mul_right_comm, mul_comm (φ _), ← key, ← hu, mul_assoc, Units.mul_inv, mul_one]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.subset_span (Set.mem_insert _ _)

/-- Membership in the local ring: quotients with denominator not vanishing at the point. -/
theorem mem_localRing {z : W.FunctionField} :
    z ∈ localRing h ↔ ∃ a s : W.CoordinateRing, s ∉ XYIdeal W x (C y) ∧
      z = algebraMap _ _ a * (algebraMap _ _ s)⁻¹ := by
  have := (isMaximal_XYIdeal h.1).isPrime
  unfold localRing
  rw [Localization.subalgebra.ofField]
  change (∃ a s, ∃ _ : s ∈ (XYIdeal W x (C y)).primeCompl, z = _) ↔ _
  simp only [Ideal.mem_primeCompl_iff, exists_prop]

/-- The coordinate ring is contained in the local ring at a point. -/
theorem algebraMap_mem_localRing (r : W.CoordinateRing) :
    algebraMap W.CoordinateRing W.FunctionField r ∈ localRing h :=
  Subalgebra.algebraMap_mem _ r

/-- The inverse of an element not vanishing at the point is in the local ring. -/
theorem inv_mem_localRing {s : W.CoordinateRing} (hs : s ∉ XYIdeal W x (C y)) :
    (algebraMap W.CoordinateRing W.FunctionField s)⁻¹ ∈ localRing h :=
  (mem_localRing h).mpr ⟨1, s, hs, by rw [map_one, one_mul]⟩

/-- The inverse of a nonzero element of the ideal of the point is not in the local ring. -/
theorem inv_not_mem_localRing {r : W.CoordinateRing} (hr : r ∈ XYIdeal W x (C y)) (h0 : r ≠ 0) :
    (algebraMap W.CoordinateRing W.FunctionField r)⁻¹ ∉ localRing h := by
  have := (isMaximal_XYIdeal h.1).isPrime
  have := isLocalization_localRing h
  have := IsLocalization.AtPrime.isLocalRing (localRing h) (XYIdeal W x (C y))
  intro hinv
  have hmax : algebraMap W.CoordinateRing (localRing h) r ∈ maximalIdeal (localRing h) := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (XYIdeal W x (C y)) (localRing h)]
    exact Ideal.mem_map_of_mem _ hr
  have hr0 : algebraMap W.CoordinateRing W.FunctionField r ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr h0
  apply (maximalIdeal.isMaximal (localRing h)).ne_top
  refine Ideal.eq_top_of_isUnit_mem _ hmax ⟨⟨_, ⟨_, hinv⟩, ?_, ?_⟩, rfl⟩ <;>
    exact Subtype.ext (by simp [hr0])

/-- The local ring at a nonsingular point is a valuation ring. -/
theorem valuationRing_localRing : ValuationRing (localRing h) := by
  have := (isMaximal_XYIdeal h.1).isPrime
  have := isLocalization_localRing h
  have := IsLocalization.AtPrime.isLocalRing (localRing h) (XYIdeal W x (C y))
  have : IsNoetherianRing W.CoordinateRing :=
    inferInstanceAs (IsNoetherianRing (AdjoinRoot W.polynomial))
  have : IsNoetherianRing (localRing h) :=
    IsLocalization.isNoetherianRing (XYIdeal W x (C y)).primeCompl _ inferInstance
  obtain ⟨π, -, hπ⟩ := exists_maximalIdeal_localRing_eq_span h
  have hp : (maximalIdeal (localRing h)).IsPrincipal := ⟨_, hπ⟩
  exact ((tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain (R := localRing h)).out 5 2).mp hp

/-- The valuation subring of a nonsingular point. -/
noncomputable def pointValuationSubring : ValuationSubring W.FunctionField :=
  ValuationSubring.ofSubring (localRing h).toSubring fun z => by
    have := valuationRing_localRing h
    rcases (ValuationRing.iff_isInteger_or_isInteger (localRing h) W.FunctionField).mp this z with
      ⟨a, ha⟩ | ⟨a, ha⟩
    · exact .inl (ha ▸ a.2)
    · exact .inr (ha ▸ a.2)

/-- Membership in the valuation subring of a point. -/
theorem mem_pointValuationSubring {z : W.FunctionField} :
    z ∈ pointValuationSubring h ↔ z ∈ localRing h :=
  Iff.rfl

end LocalRing

/-! ### The place of a point -/

section Place

variable (h : W.Nonsingular x y)

/-- The function `x - x₀`. -/
theorem algebraMap_XClass :
    algebraMap W.CoordinateRing W.FunctionField (XClass W x) = W.fieldX - algebraMap F _ x := by
  rw [XClass, ← aeval_fieldX, map_sub, aeval_X, aeval_C]

/-- The function `y - y₀`. -/
theorem algebraMap_YClass :
    algebraMap W.CoordinateRing W.FunctionField (YClass W (C y)) =
      W.fieldY - algebraMap F _ y := by
  rw [YClass, map_sub, map_sub, fieldY_def, IsScalarTower.algebraMap_apply F W.CoordinateRing]
  rfl

/-- The place of a nonsingular point. -/
noncomputable def pointPlace : FunctionField.Place F W.FunctionField where
  ring := pointValuationSubring h
  algebraMap_mem c := by
    rw [mem_pointValuationSubring, IsScalarTower.algebraMap_apply F W.CoordinateRing]
    exact algebraMap_mem_localRing h _
  ne_top htop := inv_not_mem_localRing h XClass_mem_XYIdeal (XClass_ne_zero x) <| by
    rw [← mem_pointValuationSubring, htop]
    exact ValuationSubring.mem_top _

/-- Membership in the place of a point. -/
theorem mem_pointPlace {z : W.FunctionField} : z ∈ (pointPlace h).ring ↔ z ∈ localRing h :=
  Iff.rfl

/-- The place of a nonsingular point is rational: the residue of `a / s` is the quotient of the
values of `a` and `s`. -/
theorem isRational_pointPlace : (pointPlace h).IsRational := by
  rw [FunctionField.Place.isRational_iff]
  intro z hz
  obtain ⟨a, s, hs, rfl⟩ := (mem_localRing h).mp hz
  set m := XYIdeal W x (C y)
  set e := quotientXYIdealEquiv (W' := W) (x := x) (y := C y) h.1
  have he : ∀ r : W.CoordinateRing, e (Ideal.Quotient.mk m r) = 0 → r ∈ m := fun r hr => by
    rwa [map_eq_zero_iff _ e.injective, Ideal.Quotient.eq_zero_iff_mem] at hr
  have hcs : e (Ideal.Quotient.mk m s) ≠ 0 := fun h0 => hs (he s h0)
  set c := e (Ideal.Quotient.mk m a) / e (Ideal.Quotient.mk m s)
  have hr : a - algebraMap F _ c * s ∈ m := by
    apply he
    rw [map_sub, map_mul, map_sub, map_mul, Ideal.Quotient.mk_algebraMap, AlgEquiv.commutes]
    simp only [Algebra.algebraMap_self, RingHom.id_apply, c]
    field_simp
    ring
  refine ⟨c, ?_⟩
  have hs0 : algebraMap W.CoordinateRing W.FunctionField s ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr fun h0 => hs (h0 ▸ m.zero_mem)
  have hz : algebraMap W.CoordinateRing W.FunctionField a *
      (algebraMap W.CoordinateRing W.FunctionField s)⁻¹ - algebraMap F _ c =
      algebraMap W.CoordinateRing W.FunctionField (a - algebraMap F _ c * s) *
        (algebraMap W.CoordinateRing W.FunctionField s)⁻¹ := by
    rw [map_sub, map_mul, ← IsScalarTower.algebraMap_apply]
    field_simp
  rw [hz]
  by_cases h0 : a - algebraMap F _ c * s = 0
  · left
    rw [← sub_eq_zero, hz, h0, map_zero, zero_mul]
  · right
    intro hinv
    apply inv_not_mem_localRing h hr h0
    have hr0 : algebraMap W.CoordinateRing W.FunctionField (a - algebraMap F _ c * s) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr h0
    have := mul_mem (inv_mem_localRing h hs) hinv
    convert this using 1
    field_simp

/-- The rational place of a nonsingular point. -/
noncomputable def pointRationalPlace : FunctionField.RationalPlace F W.FunctionField :=
  ⟨pointPlace h, isRational_pointPlace h⟩

/-- An element of the ideal of the point vanishes at its place. -/
theorem hasValue_of_mem {r : W.CoordinateRing} (hr : r ∈ XYIdeal W x (C y)) :
    (pointRationalPlace h).HasValue (algebraMap W.CoordinateRing W.FunctionField r) 0 := by
  have hm : algebraMap W.CoordinateRing W.FunctionField r ∈ (pointRationalPlace h).1.ring :=
    algebraMap_mem_localRing h r
  refine FunctionField.RationalPlace.hasValue_iff.mpr ⟨hm, ?_⟩
  rw [FunctionField.RationalPlace.eval_eq_zero_iff]
  by_cases h0 : r = 0
  · left; rw [h0, map_zero]
  · right; exact inv_not_mem_localRing h hr h0

/-- `x` takes the value `x₀` at the place of `(x₀, y₀)`. -/
theorem hasValue_fieldX : (pointRationalPlace h).HasValue W.fieldX x := by
  have h1 := (hasValue_of_mem h XClass_mem_XYIdeal).add
    (FunctionField.RationalPlace.hasValue_algebraMap (P := pointRationalPlace h) x)
  rw [algebraMap_XClass, sub_add_cancel, zero_add] at h1
  exact h1

/-- `y` takes the value `y₀` at the place of `(x₀, y₀)`. -/
theorem hasValue_fieldY : (pointRationalPlace h).HasValue W.fieldY y := by
  have h1 := (hasValue_of_mem h YClass_mem_XYIdeal).add
    (FunctionField.RationalPlace.hasValue_algebraMap (P := pointRationalPlace h) y)
  rw [algebraMap_YClass, sub_add_cancel, zero_add] at h1
  exact h1

end Place

/-! ### Every place where `x` is regular is the place of a point -/

section Classification

open FunctionField.RationalPlace

variable {P : FunctionField.RationalPlace F W.FunctionField}

/-- Where `x` is regular, so is `y`: it is integral over the regular functions. -/
theorem fieldY_mem_of_fieldX_mem (hx : W.fieldX ∈ P.1.ring) : W.fieldY ∈ P.1.ring := by
  by_contra hy
  have hX := HasValue.of_mem hx
  have hc := fun c => hasValue_algebraMap (P := P) c
  have hr := ((((hX.pow 3).add ((hc W.a₂).mul (hX.pow 2))).add ((hc W.a₄).mul hX)).add
    (hc W.a₆)).mem
  have hl := ((hc W.a₁).mul hX).add (hc W.a₃) |>.mem
  have hinv := inv_mem_of_not_mem hy
  have hy0 := W.fieldY_ne_zero
  have e : W.fieldY = (W.fieldX ^ 3 + algebraMap F _ W.a₂ * W.fieldX ^ 2 +
      algebraMap F _ W.a₄ * W.fieldX + algebraMap F _ W.a₆) * W.fieldY⁻¹ -
        (algebraMap F _ W.a₁ * W.fieldX + algebraMap F _ W.a₃) := by
    rw [← W.fieldY_equation]
    field_simp
    ring
  exact hy (e ▸ sub_mem (mul_mem hr hinv) hl)

/-- Where `x` is regular, so is every element of the coordinate ring. -/
theorem exists_hasValue_algebraMap (hx : W.fieldX ∈ P.1.ring) (r : W.CoordinateRing) :
    ∃ c, P.HasValue (algebraMap W.CoordinateRing W.FunctionField r) c := by
  obtain ⟨p, q, rfl⟩ := CoordinateRing.exists_smul_basis_eq r
  rw [algebraMap_smul_basis]
  exact ⟨_, ((HasValue.of_mem hx).aeval p).add (((HasValue.of_mem hx).aeval q).mul
    (HasValue.of_mem (fieldY_mem_of_fieldX_mem hx)))⟩

/-- The values of `x` and `y` at a rational place satisfy the equation. -/
theorem equation_of_hasValue {x₀ y₀ : F} (hx : P.HasValue W.fieldX x₀)
    (hy : P.HasValue W.fieldY y₀) : W.Equation x₀ y₀ := by
  have hc := fun c => hasValue_algebraMap (P := P) c
  have hl := ((hy.pow 2).add (((hc W.a₁).mul hx).mul hy)).add ((hc W.a₃).mul hy)
  have hr := (((hx.pow 3).add ((hc W.a₂).mul (hx.pow 2))).add ((hc W.a₄).mul hx)).add (hc W.a₆)
  rw [W.fieldY_equation] at hl
  rw [equation_iff]
  exact hl.unique hr

/-- **Classification of the places with `x` regular**: a rational place where `x` is regular is
the place of the point `(x(P), y(P))`. -/
theorem eq_pointRationalPlace {x₀ y₀ : F} (h : W.Nonsingular x₀ y₀) (hx : P.HasValue W.fieldX x₀)
    (hy : P.HasValue W.fieldY y₀) : P = pointRationalPlace h := by
  set m := XYIdeal W x₀ (C y₀)
  have hc := fun c => hasValue_algebraMap (P := P) c
  -- the ideal of the point vanishes at `P`
  have hm : ∀ r ∈ m, P.HasValue (algebraMap W.CoordinateRing W.FunctionField r) 0 := by
    intro r hr
    obtain ⟨a, b, rfl⟩ := Ideal.mem_span_pair.mp hr
    obtain ⟨ca, ha⟩ := exists_hasValue_algebraMap hx.mem a
    obtain ⟨cb, hb⟩ := exists_hasValue_algebraMap hx.mem b
    have hX : P.HasValue (algebraMap W.CoordinateRing W.FunctionField (XClass W x₀)) 0 := by
      rw [algebraMap_XClass]; exact (hx.sub (hc x₀)).congr rfl (sub_self _)
    have hY : P.HasValue (algebraMap W.CoordinateRing W.FunctionField (YClass W (C y₀))) 0 := by
      rw [algebraMap_YClass]; exact (hy.sub (hc y₀)).congr rfl (sub_self _)
    rw [map_add, map_mul, map_mul]
    exact ((ha.mul hX).add (hb.mul hY)).congr rfl (by ring)
  -- the elements outside it do not
  have hs : ∀ s ∉ m, ∃ c ≠ 0, P.HasValue (algebraMap W.CoordinateRing W.FunctionField s) c := by
    intro s hs
    set e := quotientXYIdealEquiv (W' := W) (x := x₀) (y := C y₀) h.1
    have he : ∀ r : W.CoordinateRing, e (Ideal.Quotient.mk m r) = 0 → r ∈ m := fun r hr => by
      rwa [map_eq_zero_iff _ e.injective, Ideal.Quotient.eq_zero_iff_mem] at hr
    refine ⟨e (Ideal.Quotient.mk m s), fun h0 => hs (he s h0), ?_⟩
    have hsub : s - algebraMap F _ (e (Ideal.Quotient.mk m s)) ∈ m := he _ (by
      rw [map_sub, map_sub, Ideal.Quotient.mk_algebraMap, AlgEquiv.commutes]
      simp)
    have := (hm _ hsub).add (hc (e (Ideal.Quotient.mk m s)))
    rw [map_sub, ← IsScalarTower.algebraMap_apply, sub_add_cancel, zero_add] at this
    exact this
  -- the local ring of the point is contained in the valuation ring of `P`
  have hle : ∀ z ∈ localRing h, z ∈ P.1.ring := by
    intro z hz
    obtain ⟨a, s, hsm, rfl⟩ := (mem_localRing h).mp hz
    obtain ⟨ca, ha⟩ := exists_hasValue_algebraMap hx.mem a
    obtain ⟨cs, hcs, hs'⟩ := hs s hsm
    exact (ha.mul (hs'.inv hcs)).mem
  refine Subtype.ext (FunctionField.Place.ext ?_)
  ext z
  refine ⟨fun hz => ?_, fun hz => hle z hz⟩
  -- conversely, a function regular at `P` but not at the point would have an inverse in the
  -- maximal ideal of the local ring, hence vanishing at `P`
  change z ∈ localRing h
  by_contra hzA
  have := (isMaximal_XYIdeal h.1).isPrime
  have := isLocalization_localRing h
  have := IsLocalization.AtPrime.isLocalRing (localRing h) m
  have hzi : z⁻¹ ∈ localRing h := ((pointValuationSubring h).mem_or_inv_mem z).resolve_left hzA
  have hz0 : z ≠ 0 := fun h0 => hzA (h0 ▸ (localRing h).zero_mem)
  have hmax : (⟨z⁻¹, hzi⟩ : localRing h) ∈ maximalIdeal (localRing h) := by
    rw [mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨⟨_, w, hw, -⟩, rfl⟩
    apply hzA
    have hw' : z⁻¹ * (w : W.FunctionField) = 1 := congrArg Subtype.val hw
    have hwz : (w : W.FunctionField) = z := by rw [eq_inv_of_mul_eq_one_right hw', inv_inv]
    exact hwz ▸ w.2
  obtain ⟨π, hπ, hπm⟩ := exists_maximalIdeal_localRing_eq_span h
  rw [hπm, Ideal.mem_span_singleton'] at hmax
  obtain ⟨b, hb⟩ := hmax
  have hb' : (b : W.FunctionField) * algebraMap W.CoordinateRing W.FunctionField π = z⁻¹ :=
    congrArg Subtype.val hb
  have hπ0 : P.HasValue (algebraMap W.CoordinateRing W.FunctionField π) 0 := by
    rcases hπ with rfl | rfl
    · exact hm _ XClass_mem_XYIdeal
    · exact hm _ YClass_mem_XYIdeal
  have hzinv := (HasValue.of_mem (hle b b.2)).mul hπ0
  rw [hb'] at hzinv
  have h1 := (HasValue.of_mem hz).mul hzinv
  rw [mul_inv_cancel₀ hz0] at h1
  exact one_ne_zero ((hasValue_one.unique h1).trans (by simp))

end Classification

